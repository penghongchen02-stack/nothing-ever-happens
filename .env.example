# Deployment mode (secrets and toggles only — everything else is in config.json)
BOT_MODE=paper
DRY_RUN=true
LIVE_TRADING_ENABLED=false

# Venue: "global" (polymarket.com) or "us" (polymarket.us, paper trading only for now)
POLYMARKET_VENUE=global

# Polymarket US API key (polymarket.us/developer). Required for POLYMARKET_VENUE=us:
# live order books are only available on the authenticated WebSocket.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# Secrets
PRIVATE_KEY=
# Required for signature_type 1 or 2 live accounts
FUNDER_ADDRESS=
# Required for BOT_MODE=live
DATABASE_URL=
# Required for proxy-wallet approval bootstrap in live signature_type=2 mode
POLYGON_RPC_URL=

# Config file path (default: config.json)
# CONFIG_PATH=config.json
